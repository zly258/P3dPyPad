<Project>

  <!--
    AutoCAD / Plant 3D 2019 引用。
    可用环境变量覆盖：CAD_LIB_2019 / PLANT3D_LIB_2019
  -->
  <PropertyGroup>
    <RepoRoot>$(MSBuildThisFileDirectory)</RepoRoot>

    <!--
      所有 C# 编译产物统一落在仓库根的 build/ 下，源码树保持干净：
        build/bin/{Debug,Release}   程序集输出
        build/obj                   中间产物
      注意 BaseIntermediateOutputPath 必须带结尾反斜杠，且要在
      Microsoft.Common.props 导入前赋值——Directory.Build.props 正好满足。
    -->
    <BuildRoot>$(RepoRoot)build\</BuildRoot>
    <BaseOutputPath>$(BuildRoot)bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>$(BuildRoot)obj\</BaseIntermediateOutputPath>

    <CadLibPath Condition="'$(CadLibPath)' == '' and '$(CAD_LIB_2019)' != ''">$(CAD_LIB_2019)</CadLibPath>
    <CadLibPath Condition="'$(CadLibPath)' == ''">$(RepoRoot)..\..\vs2019\cad_lib_2019</CadLibPath>

    <Plant3DLibPath Condition="'$(Plant3DLibPath)' == '' and '$(PLANT3D_LIB_2019)' != ''">$(PLANT3D_LIB_2019)</Plant3DLibPath>
    <Plant3DLibPath Condition="'$(Plant3DLibPath)' == ''">$(RepoRoot)..\..\vs2019\plant3d_lib_2019</Plant3DLibPath>

    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>7.3</LangVersion>
    <Deterministic>true</Deterministic>
    <NeutralLanguage>zh-Hans</NeutralLanguage>

    <!-- 中文显示名统一在此定义，安装包与清单也引用同一套叫法。 -->
    <ProductDisplayName>Plant 3D 参数化构件工具集</ProductDisplayName>
    <ProductDescription>AutoCAD Plant 3D 2019 参数化构件调试、批量校验与自动出图插件</ProductDescription>
  </PropertyGroup>

</Project>
