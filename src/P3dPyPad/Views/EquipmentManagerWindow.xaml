<Window x:Class="P3dPyPad.EquipmentManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="创建设备"
        Width="1000"
        Height="640"
        MinWidth="820"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/P3dPyPad;component/Theme/DefaultMetrics.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部标题条 -->
        <Border Grid.Row="0" Style="{StaticResource Panel.ToolStrip}" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="HeaderTitleText"
                           Grid.Column="0"
                           Text="请选择设备"
                           FontSize="14"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />

                <Button x:Name="RefreshCatalogButton"
                        Grid.Column="1"
                        Content="刷新"
                        Click="RefreshCatalog_Click" />
            </Grid>
        </Border>

        <!-- 主体两栏 -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.34*" MinWidth="270" MaxWidth="420" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" MinWidth="440" />
            </Grid.ColumnDefinitions>

            <!-- 左栏：设备库 -->
            <GroupBox Grid.Column="0" Header="设备库" Margin="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchBox"
                                 Grid.Column="0"
                                 TextChanged="FilterChanged"
                                 ToolTip="搜索设备名称或分类" />
                        <TextBlock x:Name="SearchPlaceholder"
                                   Grid.Column="0"
                                   Text="搜索设备..."
                                   Foreground="{x:Static SystemColors.GrayTextBrush}"
                                   Margin="8,0,0,0"
                                   IsHitTestVisible="False" />
                        <Button x:Name="ClearSearchButton"
                                Grid.Column="1"
                                Content="清除"
                                MinWidth="46"
                                Margin="4,1,0,1"
                                Visibility="Collapsed"
                                Click="ClearSearch_Click" />
                    </Grid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,2,0,4">
                        <RadioButton x:Name="FilterAllRadio" Content="全部" IsChecked="True" Margin="0,0,12,0" Checked="FilterChanged" />
                        <RadioButton x:Name="FilterCustomRadio" Content="自定义" Margin="0,0,12,0" Checked="FilterChanged" />
                        <RadioButton x:Name="FilterBuiltInRadio" Content="原厂" Checked="FilterChanged" />
                    </StackPanel>

                    <ComboBox x:Name="CategoryComboBox"
                              Grid.Row="2"
                              Margin="0,0,0,6"
                              SelectionChanged="FilterChanged" />

                    <ListBox x:Name="TemplateListBox"
                             Grid.Row="3"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="TemplateListBox_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,2" ToolTip="{Binding Subtitle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0"
                                            Width="38"
                                            Height="38"
                                            Background="White"
                                            BorderBrush="{x:Static SystemColors.ControlLightBrush}"
                                            BorderThickness="1"
                                            Padding="1">
                                        <Image Source="{Binding Thumbnail}"
                                               Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Border>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding DisplayName}"
                                               Margin="8,0,0,0"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </GroupBox>

            <GridSplitter Grid.Column="1"
                          Width="8"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="{x:Static SystemColors.ControlBrush}"
                          BorderBrush="{x:Static SystemColors.ControlDarkBrush}"
                          BorderThickness="1,0,0,0"
                          ShowsPreview="True"
                          ResizeBehavior="PreviousAndNext" />

            <!-- 右栏：上方示意图+标高/旋转，下方直接尺寸参数表 -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="230" MinHeight="170" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="*" MinHeight="180" />
                </Grid.RowDefinitions>

                <!-- 上方：示意图 + 标高/旋转 -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.25*" MinWidth="240" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="0.75*" MinWidth="180" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Panel.Card}" Padding="4">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border x:Name="CreatePreviewViewport"
                                    Grid.Row="0"
                                    Background="White"
                                    ClipToBounds="True"
                                    MouseWheel="Preview_MouseWheel"
                                    MouseLeftButtonDown="Preview_MouseLeftButtonDown"
                                    MouseLeftButtonUp="Preview_MouseLeftButtonUp"
                                    MouseMove="Preview_MouseMove">
                                <Grid>
                                    <Image x:Name="CreatePreviewImage"
                                           Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           RenderTransformOrigin="0.5,0.5">
                                        <Image.RenderTransform>
                                            <TransformGroup>
                                                <ScaleTransform x:Name="CreatePreviewScale" ScaleX="1" ScaleY="1" />
                                                <TranslateTransform x:Name="CreatePreviewTranslate" X="0" Y="0" />
                                            </TransformGroup>
                                        </Image.RenderTransform>
                                    </Image>
                                    <TextBlock x:Name="CreatePreviewEmptyText"
                                               Text="无预览图"
                                               Foreground="{x:Static SystemColors.GrayTextBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Visibility="Collapsed" />
                                </Grid>
                            </Border>

                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                                <Button Content="－" MinWidth="26" MinHeight="22" Padding="2,0" Click="ZoomOut_Click" />
                                <Button x:Name="CreateZoomResetButton" Content="100%" MinWidth="46" MinHeight="22" Padding="4,0" Margin="2,1" Click="ZoomReset_Click" />
                                <Button Content="＋" MinWidth="26" MinHeight="22" Padding="2,0" Click="ZoomIn_Click" />
                                <Button Content="大图" MinWidth="44" MinHeight="22" Padding="4,0" Margin="4,1,0,1" Click="OpenFullPreview_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <GroupBox Grid.Column="2" Header="定位" Margin="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="46" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="标高" />
                            <TextBox x:Name="ElevationTextBox" Grid.Row="0" Grid.Column="1" Text="0" Margin="0,3" />
                            <TextBlock x:Name="ElevationUnitText" Grid.Row="0" Grid.Column="2" Text="mm" Margin="6,0,0,0" Foreground="{x:Static SystemColors.GrayTextBrush}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="旋转" />
                            <TextBox x:Name="RotationTextBox" Grid.Row="1" Grid.Column="1" Text="0" Margin="0,3" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="°" Margin="6,0,0,0" Foreground="{x:Static SystemColors.GrayTextBrush}" />

                            <Button Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3"
                                    Content="恢复默认"
                                    HorizontalAlignment="Left"
                                    Click="ResetParams_Click" />
                        </Grid>
                    </GroupBox>
                </Grid>

                <GridSplitter Grid.Row="1"
                              Height="8"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Center"
                              Background="{x:Static SystemColors.ControlBrush}"
                              BorderBrush="{x:Static SystemColors.ControlDarkBrush}"
                              BorderThickness="0,1,0,0"
                              ShowsPreview="True"
                              ResizeBehavior="PreviousAndNext" />

                <!-- 下方：尺寸参数表 -->
                <GroupBox x:Name="ParamsGroupBox" Grid.Row="2" Header="尺寸参数" Margin="0">
                    <DataGrid x:Name="ParamsGrid"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="False"
                              HeadersVisibility="Column"
                              SelectionUnit="FullRow">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="参数"
                                                Binding="{Binding Name}"
                                                IsReadOnly="True"
                                                Width="130"
                                                ElementStyle="{StaticResource DataGridText.Cell}" />
                            <DataGridTextColumn Header="说明"
                                                Binding="{Binding DescriptionText}"
                                                IsReadOnly="True"
                                                MinWidth="160"
                                                Width="*"
                                                ElementStyle="{StaticResource DataGridText.Cell}" />
                            <DataGridTextColumn Header="数值"
                                                Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                Width="110"
                                                ElementStyle="{StaticResource DataGridText.Cell}"
                                                EditingElementStyle="{StaticResource DataGridText.EditingCell}" />
                            <DataGridTextColumn Header="单位"
                                                Binding="{Binding Unit}"
                                                IsReadOnly="True"
                                                Width="56"
                                                ElementStyle="{StaticResource DataGridText.Cell}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>
            </Grid>
        </Grid>

        <!-- 底部动作栏 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="StatusText"
                       Grid.Column="0"
                       Text="就绪"
                       Foreground="{x:Static SystemColors.GrayTextBrush}"
                       TextTrimming="CharacterEllipsis" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="PrimaryActionButton"
                        Content="创建放置"
                        MinWidth="92"
                        FontWeight="SemiBold"
                        Margin="0,0,8,0"
                        Click="PrimaryAction_Click" />
                <Button x:Name="CloseButton"
                        Content="关闭"
                        MinWidth="72"
                        IsCancel="True"
                        Click="Close_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
