<Window x:Class="P3dPyPad.EquipmentManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Plant 3D 设备管理器"
        Width="1080"
        Height="690"
        MinWidth="860"
        MinHeight="520"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/P3dPyPad;component/Theme/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis" />

            <!-- 来源筛选紧凑按钮 -->
            <Style x:Key="EqFilterToggle" TargetType="RadioButton">
                <Setter Property="Height" Value="26" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
                <Setter Property="Background" Value="{StaticResource Brush.SurfaceAlt}" />
                <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Accent}" />
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 左侧设备卡片列表项 -->
            <Style x:Key="EqCardListItem" TargetType="ListBoxItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,0,0,4" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="CardBd"
                                    Background="{StaticResource Brush.Surface}"
                                    BorderBrush="{StaticResource Brush.Border}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="8,7"
                                    Cursor="Hand">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="CardBd" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                                    <Setter TargetName="CardBd" Property="Background" Value="{StaticResource Brush.SurfaceAlt}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="CardBd" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                                    <Setter TargetName="CardBd" Property="BorderThickness" Value="1.5" />
                                    <Setter TargetName="CardBd" Property="Background" Value="#EFF6FF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{StaticResource Brush.WindowBackground}">
        <Grid.RowDefinitions>
            <!-- 0: 顶部标题与操作栏 -->
            <RowDefinition Height="Auto" />
            <!-- 1: 主体两栏 -->
            <RowDefinition Height="*" />
            <!-- 2: 底部状态与动作栏 -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ==================== 0: 顶部栏 ==================== -->
        <Border Grid.Row="0"
                Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 模式徽章 -->
                <Border x:Name="ModeBadge"
                        Grid.Column="0"
                        Background="#2563EB"
                        CornerRadius="4"
                        Padding="8,3"
                        VerticalAlignment="Center"
                        Margin="0,0,10,0">
                    <TextBlock x:Name="ModeBadgeText"
                               Text="创建设备"
                               Foreground="White"
                               FontSize="12"
                               FontWeight="SemiBold" />
                </Border>

                <!-- 当前设备主标题 -->
                <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center">
                    <TextBlock x:Name="HeaderTitleText"
                               Text="请选择设备模板"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Brush.Text.Primary}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="HeaderSubtitleText"
                               Text=""
                               FontSize="11.5"
                               Foreground="{StaticResource Brush.Text.Secondary}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!-- 右侧快捷动作 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="PickEquipmentButton"
                            Content="重新拾取设备"
                            Style="{StaticResource Button.Secondary}"
                            Height="{StaticResource Layout.ControlHeight}"
                            Margin="0,0,6,0"
                            Visibility="Collapsed"
                            Click="PickEquipment_Click"
                            ToolTip="在当前图面重新点选一台 Plant 3D 设备进行编辑" />
                    <Button x:Name="RefreshCatalogButton"
                            Content="刷新设备库"
                            Style="{StaticResource Button.Secondary}"
                            Height="{StaticResource Layout.ControlHeight}"
                            Click="RefreshCatalog_Click"
                            ToolTip="重新扫描 CPak Common\equipment 目录，无需重启 Plant 3D 即可发现新发布的设备" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== 1: 主体两栏 ==================== -->
        <Grid Grid.Row="1" Margin="10,10,10,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftColumn" Width="0.36*" MinWidth="310" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" MinWidth="460" />
            </Grid.ColumnDefinitions>

            <!-- ========== 左栏 ========== -->
            <Border Grid.Column="0"
                    Background="{StaticResource Brush.Surface}"
                    BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="8">
                <Grid>
                    <!-- 创建模式：左栏为设备浏览器 -->
                    <Grid x:Name="CreateCatalogPanel">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- 搜索框 -->
                        <Grid Grid.Row="0" Margin="0,0,0,6">
                            <TextBox x:Name="SearchBox"
                                     Height="{StaticResource Layout.ControlHeight}"
                                     VerticalContentAlignment="Center"
                                     Padding="8,0,28,0"
                                     TextChanged="FilterChanged"
                                     ToolTip="按中文名称、脚本代号或分类实时过滤" />
                            <TextBlock x:Name="SearchPlaceholder"
                                       Text="搜索设备名称 / 代号 / 分类..."
                                       Foreground="{StaticResource Brush.Text.Muted}"
                                       FontSize="12"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False" />
                            <Button x:Name="ClearSearchButton"
                                    Content="×"
                                    Width="22"
                                    Height="22"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Margin="0,0,4,0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="{StaticResource Brush.Text.Secondary}"
                                    Cursor="Hand"
                                    Visibility="Collapsed"
                                    Click="ClearSearch_Click" />
                        </Grid>

                        <!-- 来源快捷筛选 -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,6">
                            <RadioButton x:Name="FilterAllRadio"
                                         Content="全部"
                                         IsChecked="True"
                                         Style="{StaticResource EqFilterToggle}"
                                         Margin="0,0,4,0"
                                         Checked="FilterChanged" />
                            <RadioButton x:Name="FilterCustomRadio"
                                         Content="自定义"
                                         Style="{StaticResource EqFilterToggle}"
                                         Margin="0,0,4,0"
                                         Checked="FilterChanged" />
                            <RadioButton x:Name="FilterBuiltInRadio"
                                         Content="原厂"
                                         Style="{StaticResource EqFilterToggle}"
                                         Checked="FilterChanged" />
                        </StackPanel>

                        <!-- 分类筛选下拉 -->
                        <ComboBox x:Name="CategoryComboBox"
                                  Grid.Row="2"
                                  Height="{StaticResource Layout.ControlHeight}"
                                  Margin="0,0,0,6"
                                  SelectionChanged="FilterChanged" />

                        <!-- 设备卡片列表 -->
                        <ListBox x:Name="TemplateListBox"
                                 Grid.Row="3"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ItemContainerStyle="{StaticResource EqCardListItem}"
                                 SelectionChanged="TemplateListBox_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="52" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0"
                                                Width="48"
                                                Height="48"
                                                Background="White"
                                                BorderBrush="{StaticResource Brush.Border}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="2">
                                            <Image Source="{Binding Thumbnail}"
                                                   Stretch="Uniform"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontSize="12.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource Brush.Text.Primary}"
                                                       TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding DisplayName}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                <Border Background="#E2E8F0"
                                                        CornerRadius="3"
                                                        Padding="5,1"
                                                        Margin="0,0,5,0">
                                                    <TextBlock Text="{Binding CategoryDisplayName}"
                                                               FontSize="10.5"
                                                               Foreground="#334155" />
                                                </Border>
                                                <Border Background="#DBEAFE"
                                                        CornerRadius="3"
                                                        Padding="5,1"
                                                        Margin="0,0,5,0"
                                                        Visibility="{Binding IsCustom, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="{Binding SourceBadge}"
                                                               FontSize="10.5"
                                                               Foreground="#1D4ED8" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="10.5"
                                                       FontFamily="Consolas"
                                                       Foreground="{StaticResource Brush.Text.Muted}"
                                                       Margin="0,2,0,0"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- 底部统计 -->
                        <TextBlock x:Name="CatalogCountText"
                                   Grid.Row="4"
                                   Text=""
                                   FontSize="11"
                                   Foreground="{StaticResource Brush.Text.Secondary}"
                                   Margin="2,6,0,0" />
                    </Grid>

                    <!-- 编辑模式：左栏直接展示超大可缩放预览图 + 设备信息 -->
                    <Grid x:Name="EditPreviewPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border x:Name="EditPreviewViewport"
                                Grid.Row="0"
                                Background="White"
                                BorderBrush="{StaticResource Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="6"
                                ClipToBounds="True"
                                MouseWheel="Preview_MouseWheel"
                                MouseLeftButtonDown="Preview_MouseLeftButtonDown"
                                MouseLeftButtonUp="Preview_MouseLeftButtonUp"
                                MouseMove="Preview_MouseMove">
                            <Grid>
                                <Image x:Name="EditPreviewImage"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       RenderTransformOrigin="0.5,0.5">
                                    <Image.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform x:Name="EditPreviewScale" ScaleX="1" ScaleY="1" />
                                            <TranslateTransform x:Name="EditPreviewTranslate" X="0" Y="0" />
                                        </TransformGroup>
                                    </Image.RenderTransform>
                                </Image>
                                <TextBlock x:Name="EditPreviewEmptyText"
                                           Text="暂无预览图"
                                           Foreground="{StaticResource Brush.Text.Muted}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="Collapsed" />
                            </Grid>
                        </Border>

                        <!-- 缩放控制条 -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,8">
                            <Button Content="－" Width="28" Height="26" Style="{StaticResource Button.Secondary}" Click="ZoomOut_Click" ToolTip="缩小" />
                            <Button x:Name="EditZoomResetButton" Content="100%" MinWidth="54" Height="26" Margin="4,0" Style="{StaticResource Button.Secondary}" Click="ZoomReset_Click" ToolTip="双击或点击重置缩放" />
                            <Button Content="＋" Width="28" Height="26" Style="{StaticResource Button.Secondary}" Click="ZoomIn_Click" ToolTip="放大" />
                            <Button Content="全屏看图" Height="26" Margin="8,0,0,0" Padding="10,0" Style="{StaticResource Button.Secondary}" Click="OpenFullPreview_Click" ToolTip="弹出高清大图窗口查看参数标注" />
                        </StackPanel>

                        <!-- 设备摘要卡片 -->
                        <Border Grid.Row="2"
                                Background="{StaticResource Brush.SurfaceAlt}"
                                BorderBrush="{StaticResource Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10,8">
                            <StackPanel>
                                <TextBlock x:Name="EditSummaryName" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Primary}" TextWrapping="Wrap" />
                                <TextBlock x:Name="EditSummaryMeta" FontSize="11.5" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                <TextBlock Text="提示：滚轮缩放预览图，按住左键拖拽平移，双击复位。"
                                           FontSize="11"
                                           Foreground="{StaticResource Brush.Text.Muted}"
                                           Margin="0,6,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- 两栏分隔条 -->
            <GridSplitter Grid.Column="1"
                          Width="6"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          Background="Transparent"
                          ResizeBehavior="PreviousAndNext" />

            <!-- ========== 右栏：预览+常规（上）与 参数/特性/管嘴 Tab（下） ========== -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <!-- 0: 创建模式下的高清可缩放预览 + 常规配置区 -->
                    <RowDefinition x:Name="CreatePreviewRow" Height="235" MinHeight="170" />
                    <RowDefinition x:Name="CreatePreviewSplitterRow" Height="6" />
                    <!-- 2: 编辑模式下的紧凑常规条 -->
                    <RowDefinition x:Name="EditGeneralRow" Height="Auto" />
                    <!-- 3: 核心 TabControl（尺寸参数 / 工程特性 / 管嘴信息） -->
                    <RowDefinition Height="*" MinHeight="220" />
                </Grid.RowDefinitions>

                <!-- 0: 创建模式上方——左高清可缩放预览图 + 右常规信息卡片 -->
                <Border x:Name="CreateTopCard"
                        Grid.Row="0"
                        Background="{StaticResource Brush.Surface}"
                        BorderBrush="{StaticResource Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.15*" MinWidth="240" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="0.85*" MinWidth="210" />
                        </Grid.ColumnDefinitions>

                        <!-- 高清可缩放预览视口 -->
                        <Grid Grid.Column="0">
                            <Border x:Name="CreatePreviewViewport"
                                    Background="White"
                                    BorderBrush="{StaticResource Brush.Border}"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    ClipToBounds="True"
                                    MouseWheel="Preview_MouseWheel"
                                    MouseLeftButtonDown="Preview_MouseLeftButtonDown"
                                    MouseLeftButtonUp="Preview_MouseLeftButtonUp"
                                    MouseMove="Preview_MouseMove">
                                <Grid>
                                    <Image x:Name="CreatePreviewImage"
                                           Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           RenderTransformOrigin="0.5,0.5">
                                        <Image.RenderTransform>
                                            <TransformGroup>
                                                <ScaleTransform x:Name="CreatePreviewScale" ScaleX="1" ScaleY="1" />
                                                <TranslateTransform x:Name="CreatePreviewTranslate" X="0" Y="0" />
                                            </TransformGroup>
                                        </Image.RenderTransform>
                                    </Image>
                                    <TextBlock x:Name="CreatePreviewEmptyText"
                                               Text="暂无预览图"
                                               Foreground="{StaticResource Brush.Text.Muted}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Visibility="Collapsed" />
                                </Grid>
                            </Border>

                            <!-- 悬浮缩放工具条 -->
                            <Border HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Margin="0,0,6,6"
                                    Background="#E6FFFFFF"
                                    BorderBrush="{StaticResource Brush.Border}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="3,2">
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="－" Width="22" Height="22" Padding="0" Style="{StaticResource Button.Secondary}" Click="ZoomOut_Click" ToolTip="缩小" />
                                    <Button x:Name="CreateZoomResetButton" Content="100%" MinWidth="42" Height="22" Padding="4,0" Margin="2,0" FontSize="11" Style="{StaticResource Button.Secondary}" Click="ZoomReset_Click" ToolTip="复位缩放" />
                                    <Button Content="＋" Width="22" Height="22" Padding="0" Style="{StaticResource Button.Secondary}" Click="ZoomIn_Click" ToolTip="放大" />
                                    <Button Content="大图" Height="22" Padding="6,0" Margin="4,0,0,0" FontSize="11" Style="{StaticResource Button.Secondary}" Click="OpenFullPreview_Click" ToolTip="弹出全屏高清看图器" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- 右侧常规设置卡片 -->
                        <Grid Grid.Column="2" VerticalAlignment="Stretch">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="常规与放置参数"
                                       FontSize="12.5"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource Brush.Text.Primary}"
                                       Margin="0,0,0,8" />

                            <!-- 位号 -->
                            <Grid Grid.Row="1" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="68" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="设备位号" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Brush.Text.Secondary}" />
                                <TextBox x:Name="TagTextBox" Grid.Column="1" Height="28" VerticalContentAlignment="Center" Padding="6,0" />
                            </Grid>

                            <!-- 标高 -->
                            <Grid Grid.Row="2" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="68" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="安装标高" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Brush.Text.Secondary}" />
                                <TextBox x:Name="ElevationTextBox" Grid.Column="1" Text="0" Height="28" VerticalContentAlignment="Center" Padding="6,0" />
                                <TextBlock x:Name="ElevationUnitText" Grid.Column="2" Text="mm" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="11.5" Foreground="{StaticResource Brush.Text.Muted}" />
                            </Grid>

                            <!-- 旋转角度 -->
                            <Grid Grid.Row="3" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="68" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="默认旋转" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Brush.Text.Secondary}" />
                                <TextBox x:Name="RotationTextBox" Grid.Column="1" Text="0" Height="28" VerticalContentAlignment="Center" Padding="6,0" />
                                <TextBlock Grid.Column="2" Text="°" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="11.5" Foreground="{StaticResource Brush.Text.Muted}" />
                            </Grid>

                            <TextBlock Grid.Row="4"
                                       Text="滚轮可缩放左侧示意图，点击「大图」可全屏查看参数标注。"
                                       FontSize="11"
                                       Foreground="{StaticResource Brush.Text.Muted}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Bottom"
                                       Margin="0,0,0,6" />

                            <Button Grid.Row="5"
                                    Content="恢复默认尺寸"
                                    Style="{StaticResource Button.Secondary}"
                                    Height="28"
                                    HorizontalAlignment="Left"
                                    Padding="12,0"
                                    Click="ResetParams_Click" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- 创建模式下可拖动调整预览区高度 -->
                <GridSplitter x:Name="CreatePreviewSplitter"
                              Grid.Row="1"
                              Height="6"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Center"
                              Background="Transparent"
                              ResizeBehavior="PreviousAndNext" />

                <!-- 2: 编辑模式顶部的紧凑常规条 -->
                <Border x:Name="EditGeneralBar"
                        Grid.Row="2"
                        Visibility="Collapsed"
                        Background="{StaticResource Brush.Surface}"
                        BorderBrush="{StaticResource Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10,8"
                        Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="0.8*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="设备位号" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12" Foreground="{StaticResource Brush.Text.Secondary}" />
                        <TextBox x:Name="EditTagTextBox" Grid.Column="1" Height="28" VerticalContentAlignment="Center" Padding="6,0" />

                        <TextBlock Grid.Column="3" Text="标高" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12" Foreground="{StaticResource Brush.Text.Secondary}" />
                        <TextBox x:Name="EditElevationTextBox" Grid.Column="4" Height="28" VerticalContentAlignment="Center" Padding="6,0" />
                        <TextBlock x:Name="EditElevationUnitText" Grid.Column="5" Text="mm" VerticalAlignment="Center" Margin="5,0,0,0" FontSize="11.5" Foreground="{StaticResource Brush.Text.Muted}" />

                        <Button Grid.Column="7"
                                Content="恢复默认尺寸"
                                Style="{StaticResource Button.Secondary}"
                                Height="28"
                                Padding="10,0"
                                Click="ResetParams_Click" />
                    </Grid>
                </Border>

                <!-- 3: 核心 TabControl（尺寸参数 / 工程特性 / 管嘴信息） -->
                <Border Grid.Row="3"
                        Background="{StaticResource Brush.Surface}"
                        BorderBrush="{StaticResource Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="6">
                    <TabControl x:Name="DetailTabControl" BorderThickness="0" Background="Transparent">
                        <!-- Tab 1: 尺寸参数 -->
                        <TabItem x:Name="ParamsTab" Header="尺寸参数">
                            <Grid Margin="2,6,2,2">
                                <DataGrid x:Name="ParamsGrid"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          CanUserReorderColumns="False"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal"
                                          AlternatingRowBackground="{StaticResource Brush.SurfaceAlt}"
                                          RowHeight="30"
                                          SelectionUnit="FullRow"
                                          BorderBrush="{StaticResource Brush.Border}"
                                          BorderThickness="1">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="参数代号"
                                                            Binding="{Binding Name}"
                                                            IsReadOnly="True"
                                                            Width="140">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontFamily" Value="Consolas" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                    <Setter Property="VerticalAlignment" Value="Center" />
                                                    <Setter Property="Padding" Value="6,0" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <DataGridTextColumn Header="中文说明"
                                                            Binding="{Binding DescriptionText}"
                                                            IsReadOnly="True"
                                                            MinWidth="160"
                                                            Width="*">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="VerticalAlignment" Value="Center" />
                                                    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
                                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                                    <Setter Property="ToolTip" Value="{Binding DescriptionText}" />
                                                    <Setter Property="Padding" Value="6,0" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <DataGridTextColumn Header="数值 (可编辑)"
                                                            Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                            Width="130">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="VerticalAlignment" Value="Center" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                    <Setter Property="Foreground" Value="#1D4ED8" />
                                                    <Setter Property="Padding" Value="6,0" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <DataGridTextColumn Header="单位"
                                                            Binding="{Binding Unit}"
                                                            IsReadOnly="True"
                                                            Width="58">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="VerticalAlignment" Value="Center" />
                                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                                    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Muted}" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </TabItem>

                        <!-- Tab 2: 工程特性 -->
                        <TabItem x:Name="PropsTab" Header="工程特性">
                            <Grid Margin="2,6,2,2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="PropSearchBox"
                                             Grid.Column="0"
                                             Height="28"
                                             VerticalContentAlignment="Center"
                                             Padding="8,0"
                                             TextChanged="PropFilterChanged" />
                                    <TextBlock x:Name="PropSearchPlaceholder"
                                               Grid.Column="0"
                                               Text="搜索特性名称（如 材质、描述、制造商、重量）..."
                                               Foreground="{StaticResource Brush.Text.Muted}"
                                               FontSize="12"
                                               Margin="10,0,0,0"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False" />
                                    <CheckBox x:Name="CommonPropsOnlyCheck"
                                              Grid.Column="1"
                                              Content="仅显示常用特性"
                                              VerticalAlignment="Center"
                                              Margin="10,0,2,0"
                                              Checked="PropFilterChanged"
                                              Unchecked="PropFilterChanged" />
                                </Grid>

                                <DataGrid x:Name="PropsGrid"
                                          Grid.Row="1"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          CanUserReorderColumns="False"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal"
                                          AlternatingRowBackground="{StaticResource Brush.SurfaceAlt}"
                                          RowHeight="30"
                                          BorderBrush="{StaticResource Brush.Border}"
                                          BorderThickness="1">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="特性名称"
                                                            Binding="{Binding LabelText}"
                                                            IsReadOnly="True"
                                                            Width="200">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="VerticalAlignment" Value="Center" />
                                                    <Setter Property="Padding" Value="6,0" />
                                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                                    <Setter Property="ToolTip" Value="{Binding Name}" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <DataGridTextColumn Header="特性值 (可编辑)"
                                                            Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                            MinWidth="180"
                                                            Width="*">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="VerticalAlignment" Value="Center" />
                                                    <Setter Property="Padding" Value="6,0" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </TabItem>

                        <!-- Tab 3: 管嘴信息（独立 Tab） -->
                        <TabItem x:Name="NozzlesTab" Header="管嘴信息">
                            <Grid Margin="2,6,2,2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <DataGrid x:Name="NozzlesGrid"
                                          Grid.Row="0"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          CanUserReorderColumns="False"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal"
                                          AlternatingRowBackground="{StaticResource Brush.SurfaceAlt}"
                                          RowHeight="30"
                                          BorderBrush="{StaticResource Brush.Border}"
                                          BorderThickness="1">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="端口" Binding="{Binding PortName}" IsReadOnly="True" Width="62" />
                                        <DataGridTextColumn Header="管嘴位号 (可编辑)" Binding="{Binding NozzleTag, UpdateSourceTrigger=PropertyChanged}" Width="120" />
                                        <DataGridTextColumn Header="尺寸" Binding="{Binding NominalSize}" IsReadOnly="True" Width="76" />
                                        <DataGridTextColumn Header="压力等级" Binding="{Binding PressureClass}" IsReadOnly="True" Width="78" />
                                        <DataGridTextColumn Header="端面/连接" Binding="{Binding EndType}" IsReadOnly="True" Width="78" />
                                        <DataGridTextColumn Header="描述" Binding="{Binding LongDescription}" IsReadOnly="True" MinWidth="150" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>

                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button x:Name="AddNozzleButton"
                                            Content="添加管嘴 (Plant 3D)"
                                            Style="{StaticResource Button.Secondary}"
                                            Height="28"
                                            Padding="10,0"
                                            Margin="0,0,6,0"
                                            Click="AddNozzle_Click"
                                            ToolTip="调用 Plant 3D 原生添加管嘴命令 (_PLANTNOZZLEADD)" />
                                    <Button x:Name="EditNozzleButton"
                                            Content="编辑管嘴 (Plant 3D)"
                                            Style="{StaticResource Button.Secondary}"
                                            Height="28"
                                            Padding="10,0"
                                            Click="EditNozzle_Click"
                                            ToolTip="调用 Plant 3D 原生编辑管嘴命令 (_PLANTNOZZLEEDIT)" />
                                </StackPanel>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Border>
            </Grid>
        </Grid>

        <!-- ==================== 2: 底部状态与动作栏 ==================== -->
        <Border Grid.Row="2"
                Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="0,1,0,0"
                Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StatusText"
                           Grid.Column="0"
                           Text="就绪"
                           FontSize="12"
                           Foreground="{StaticResource Brush.Text.Secondary}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="ApplyButton"
                            Content="应用 (实时更新)"
                            Style="{StaticResource Button.Secondary}"
                            Height="32"
                            MinWidth="112"
                            Margin="0,0,8,0"
                            Visibility="Collapsed"
                            Click="ApplyEdit_Click" />
                    <Button x:Name="PrimaryActionButton"
                            Content="在图面创建放置"
                            Style="{StaticResource Button.Primary}"
                            Height="32"
                            MinWidth="126"
                            FontWeight="SemiBold"
                            Margin="0,0,8,0"
                            Click="PrimaryAction_Click" />
                    <Button x:Name="CloseButton"
                            Content="关闭"
                            Style="{StaticResource Button.Secondary}"
                            Height="32"
                            MinWidth="76"
                            Click="Close_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
