<Window x:Class="P3dPyPad.ScriptPadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
        Title="Plant 3D 参数化构件单件测试器 (PYPAD)"
        Width="1040"
        Height="640"
        MinWidth="820"
        MinHeight="460"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo x:Name="WindowTaskbarInfo" />
    </Window.TaskbarItemInfo>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/P3dPyPad;component/Theme/DefaultMetrics.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部工具栏 -->
        <Border Grid.Row="0" Style="{StaticResource Panel.ToolStrip}" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="140" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        x:Name="SelectScriptButton"
                        Content="{DynamicResource Loc.SelectScript}"
                        Margin="0,0,8,0"
                        Click="SelectScript_Click" />

                <Border Grid.Column="1" Style="{StaticResource Panel.InfoBar}" Margin="0,0,8,0">
                    <TextBlock x:Name="ScriptPathText"
                               Text="未选择脚本"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                </Border>

                <Button Grid.Column="2"
                        x:Name="SaveScriptButton"
                        Content="{DynamicResource Loc.SaveScript}"
                        Margin="0,0,6,0"
                        Click="SaveScript_Click" />

                <Button Grid.Column="3"
                        x:Name="RunButton"
                        Content="{DynamicResource Loc.RunModelF5}"
                        FontWeight="SemiBold"
                        Click="Run_Click" />
            </Grid>
        </Border>

        <!-- 主体双栏（左参数网格 + 右代码编辑器） -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.35*" MinWidth="280" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <!-- 左侧：规格表 + 参数网格 -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border x:Name="PresetBar"
                        Grid.Row="0"
                        Visibility="Collapsed"
                        Style="{StaticResource Panel.ToolStrip}"
                        Margin="0,0,0,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{DynamicResource Loc.PresetLabel}"
                                   Margin="0,0,8,0" />
                        <ComboBox x:Name="PresetBox"
                                  Grid.Column="1"
                                  IsEditable="True"
                                  IsTextSearchEnabled="False"
                                  MaxDropDownHeight="260"
                                  KeyUp="PresetBox_KeyUp"
                                  SelectionChanged="PresetBox_SelectionChanged">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" MinWidth="72" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold" Margin="0,0,8,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding DisplayName}" Foreground="{x:Static SystemColors.GrayTextBrush}" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource Panel.Card}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource Panel.Header}" Padding="6,2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="1" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{DynamicResource Loc.ParamNameColumn}" FontWeight="SemiBold" />
                                <Border Grid.Column="1" Background="{x:Static SystemColors.ControlDarkBrush}" />
                                <DockPanel Grid.Column="2" LastChildFill="True" Margin="6,0,0,0">
                                    <Button x:Name="ResetDefaultsButton"
                                            DockPanel.Dock="Right"
                                            Content="{DynamicResource Loc.ResetDefaults}"
                                            MinHeight="20"
                                            MinWidth="48"
                                            Padding="6,0"
                                            Margin="4,0,0,0"
                                            Click="ResetDefaults_Click" />
                                    <TextBlock Text="{DynamicResource Loc.ValueColumn}" FontWeight="SemiBold" />
                                    <TextBlock x:Name="ParamHeaderEntry"
                                               Text="def"
                                               Foreground="{x:Static SystemColors.GrayTextBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               HorizontalAlignment="Right"
                                               Margin="6,0,0,0" />
                                </DockPanel>
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="ParamList" />
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="1"
                          Width="8"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="{x:Static SystemColors.ControlBrush}"
                          BorderBrush="{x:Static SystemColors.ControlDarkBrush}"
                          BorderThickness="1,0,0,0"
                          ShowsPreview="True"
                          ResizeBehavior="PreviousAndNext" />

            <!-- 右侧：Python 代码编辑器 -->
            <Border Grid.Column="2" Style="{StaticResource Panel.Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource Panel.Header}">
                        <TextBlock x:Name="CodeGroupTitle"
                                   Text="Python 脚本源码"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                    </Border>

                    <avalonedit:TextEditor Grid.Row="1"
                                           x:Name="CodeEditor"
                                           FontSize="12.5"
                                           ShowLineNumbers="True"
                                           WordWrap="False"
                                           HorizontalScrollBarVisibility="Auto"
                                           VerticalScrollBarVisibility="Auto"
                                           Padding="4" />
                </Grid>
            </Border>
        </Grid>

        <!-- 底部日志区 -->
        <Border Grid.Row="2" Style="{StaticResource Panel.Card}" Padding="8,6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,4">
                    <TextBlock Text="{DynamicResource Loc.ExecutionLogTitle}" FontWeight="SemiBold" />
                    <ProgressBar x:Name="LoadingBar"
                                 DockPanel.Dock="Right"
                                 Width="120"
                                 Height="14"
                                 Margin="8,0,0,0"
                                 IsIndeterminate="True"
                                 Visibility="Collapsed" />
                    <TextBlock x:Name="StatusInfoText"
                               Text="就绪"
                               Foreground="{x:Static SystemColors.GrayTextBrush}"
                               TextTrimming="CharacterEllipsis"
                               HorizontalAlignment="Right"
                               Margin="8,0,0,0" />
                </DockPanel>

                <TextBox x:Name="LogBox"
                         Grid.Row="1"
                         Height="86"
                         FontFamily="Consolas"
                         IsReadOnly="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         VerticalContentAlignment="Top"
                         TextWrapping="Wrap"
                         Padding="4" />
            </Grid>
        </Border>
    </Grid>
</Window>
