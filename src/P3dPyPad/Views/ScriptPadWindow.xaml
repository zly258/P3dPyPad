<Window x:Class="P3dPyPad.ScriptPadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
        Title="Plant 3D 参数化构件单件测试器 (PYPAD)"
        Width="1040"
        Height="640"
        MinWidth="820"
        MinHeight="460"
        WindowStartupLocation="CenterScreen">
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo x:Name="WindowTaskbarInfo" />
    </Window.TaskbarItemInfo>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/P3dPyPad;component/Theme/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{StaticResource Brush.WindowBackground}">
        <Grid.RowDefinitions>
            <!-- 0: 顶部紧凑工具栏 -->
            <RowDefinition Height="Auto" />
            <!-- 1: 主体双栏内容区 -->
            <RowDefinition Height="*" />
            <!-- 2: 底部输出日志区 -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 0: 顶部单行极简工具栏（选择脚本 / 保存 / 运行建模 F5） -->
        <Border Grid.Row="0"
                Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="0,0,0,1"
                Padding="{StaticResource Layout.BarPadding}">
            <Grid ClipToBounds="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="120" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        x:Name="SelectScriptButton"
                        Content="{DynamicResource Loc.SelectScript}"
                        Style="{StaticResource Button.Secondary}"
                        Height="{StaticResource Layout.ControlHeight}"
                        Margin="0,0,6,0"
                        Click="SelectScript_Click"
                        ToolTip="选择一个 Python 脚本 (.py) 加载并自动解析 @param 参数" />

                <Border Grid.Column="1"
                        Background="{StaticResource Brush.SurfaceAlt}"
                        BorderBrush="{StaticResource Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Radius.Small}"
                        Height="{StaticResource Layout.ControlHeight}"
                        Margin="0,0,8,0"
                        Padding="{StaticResource Layout.InputPadding}"
                        VerticalAlignment="Center"
                        ClipToBounds="True">
                    <TextBlock x:Name="ScriptPathText"
                               Text="未选择脚本"
                               Style="{StaticResource Text.Caption}"
                               Foreground="{StaticResource Brush.Text.Primary}"
                               VerticalAlignment="Center"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                </Border>

                <Button Grid.Column="2"
                        x:Name="SaveScriptButton"
                        Content="{DynamicResource Loc.SaveScript}"
                        Style="{StaticResource Button.Secondary}"
                        Height="{StaticResource Layout.ControlHeight}"
                        Margin="0,0,6,0"
                        Click="SaveScript_Click"
                        ToolTip="将当前编辑器代码保存回脚本文件 (快捷键: Ctrl+S)" />

                <Button Grid.Column="3"
                        x:Name="RunButton"
                        Content="{DynamicResource Loc.RunModelF5}"
                        Style="{StaticResource Button.Primary}"
                        Height="{StaticResource Layout.ControlHeight}"
                        FontWeight="SemiBold"
                        Click="Run_Click"
                        ToolTip="在当前 Plant 3D 图形中生成 3D 模型 (快捷键: F5)" />
            </Grid>
        </Border>

        <!-- 1: 主体双栏内容区（左 PropertyGrid + 右代码编辑器） -->
        <Grid Grid.Row="1" Margin="{StaticResource Layout.WindowPadding}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.34*" MinWidth="280" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <!-- 左侧：自动匹配的同目录同名规格表 + PropertyGrid 参数网格 -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 仅当同目录存在同名 .csv 时自动显示 -->
                <Border x:Name="PresetBar"
                        Grid.Row="0"
                        Visibility="Collapsed"
                        Background="{StaticResource Brush.Surface}"
                        BorderBrush="{StaticResource Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Radius.Small}"
                        Padding="{StaticResource Layout.CardPadding}"
                        Margin="0,0,0,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" MinWidth="{StaticResource Layout.InputMinWidth}" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="{DynamicResource Loc.PresetLabel}"
                                   Style="{StaticResource Text.Caption}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   TextWrapping="NoWrap"
                                   Margin="0,0,8,0" />

                        <Grid Grid.Column="1">
                            <ComboBox x:Name="PresetBox"
                                      Height="{StaticResource Layout.ControlHeight}"
                                      FontSize="{StaticResource FontSize.Caption}"
                                      IsEditable="True"
                                      IsTextSearchEnabled="False"
                                      MaxDropDownHeight="{StaticResource Layout.DropDownMaxHeight}"
                                      KeyUp="PresetBox_KeyUp"
                                      SelectionChanged="PresetBox_SelectionChanged"
                                      ToolTip="自动加载同目录同名 CSV 规格表，点击下拉或输入关键字搜索">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" MinWidth="{StaticResource Layout.FormLabelMinWidth}" MaxWidth="{StaticResource Layout.FormLabelMaxWidth}" />
                                                <ColumnDefinition Width="1" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Name}"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Name}"
                                                       Margin="2,0,8,0" />
                                            <Border Grid.Column="1" Background="{StaticResource Brush.Border}" Margin="0,1" />
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding DisplayName}"
                                                       Foreground="{StaticResource Brush.Text.Secondary}"
                                                       VerticalAlignment="Center"
                                                       TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding DisplayName}"
                                                       Margin="8,0,2,0" />
                                        </Grid>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <TextBlock IsHitTestVisible="False"
                                       Text="输入或选择规格"
                                       Margin="10,0,26,0"
                                       VerticalAlignment="Center"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Text.Caption}">
                                        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Disabled}" />
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=PresetBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Grid>
                </Border>

                <!-- PropertyGrid 参数网格 -->
                <Border Grid.Row="1"
                        Background="{StaticResource Brush.Surface}"
                        BorderBrush="{StaticResource Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Radius.Small}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="{StaticResource Layout.RowHeight.GridLength}" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 表头栏 -->
                    <Border Grid.Row="0"
                            Background="{StaticResource Brush.SurfaceAlt}"
                            BorderBrush="{StaticResource Brush.Border}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{StaticResource Layout.PropertyGridNameColumn}" />
                                <ColumnDefinition Width="1" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{DynamicResource Loc.ParamNameColumn}"
                                       Style="{StaticResource Text.Caption}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       TextWrapping="NoWrap"
                                       Margin="8,0" />
                            <Border Grid.Column="1" Background="{StaticResource Brush.Border}" />
                            <DockPanel Grid.Column="2" LastChildFill="True" Margin="8,0">
                                <Button x:Name="ResetDefaultsButton"
                                        DockPanel.Dock="Right"
                                        Content="{DynamicResource Loc.ResetDefaults}"
                                        Style="{StaticResource Button.Text}"
                                        Height="22"
                                        Padding="6,0"
                                        Margin="4,0,0,0"
                                        Click="ResetDefaults_Click"
                                        ToolTip="将所有参数重置为函数初始默认值" />
                                <TextBlock Text="{DynamicResource Loc.ValueColumn}"
                                           Style="{StaticResource Text.Caption}"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           TextWrapping="NoWrap"
                                           ToolTip="参数取值：可直接输入数值或 Python 表达式" />
                                <TextBlock x:Name="ParamHeaderEntry"
                                           Text="def (参数)"
                                           Style="{StaticResource Text.Caption}"
                                           Foreground="{StaticResource Brush.Text.Secondary}"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Margin="8,0,0,0" />
                            </DockPanel>
                        </Grid>
                    </Border>

                    <!-- PropertyGrid 动态行滚动区 -->
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="ParamList" />
                    </ScrollViewer>
                </Grid>
            </Border>
            </Grid>

            <!-- 中间可拖拽调整宽度的分隔线 -->
            <GridSplitter Grid.Column="1"
                          Width="6"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          Background="Transparent"
                          Cursor="SizeWE" />

            <!-- 右侧：Python 代码编辑器 -->
            <Border Grid.Column="2"
                    Background="{StaticResource Brush.Surface}"
                    BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Small}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="{StaticResource Layout.RowHeight.GridLength}" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="{StaticResource Brush.SurfaceAlt}"
                            BorderBrush="{StaticResource Brush.Border}"
                            BorderThickness="0,0,0,1"
                            Padding="{StaticResource Layout.InputPadding}">
                        <DockPanel LastChildFill="True">
                            <TextBlock x:Name="CodeGroupTitle"
                                       Text="Python 脚本源码 (Plant 3D 内核)"
                                       Style="{StaticResource Text.Caption}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                        </DockPanel>
                    </Border>

                    <avalonedit:TextEditor Grid.Row="1"
                                           x:Name="CodeEditor"
                                           FontSize="{StaticResource FontSize.Code}"
                                           ShowLineNumbers="True"
                                           WordWrap="False"
                                           HorizontalScrollBarVisibility="Auto"
                                           VerticalScrollBarVisibility="Auto"
                                           Padding="{StaticResource Layout.InputPadding}" />
                </Grid>
            </Border>
        </Grid>

        <!-- 2: 底部紧凑日志输出区 -->
        <Border Grid.Row="2"
                Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="0,1,0,0"
                Margin="0,0,0,0"
                Padding="{StaticResource Layout.StatusBarPadding}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="{StaticResource Layout.RowHeight.Inline}" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" LastChildFill="True">
                    <TextBlock Text="{DynamicResource Loc.ExecutionLogTitle}"
                               Style="{StaticResource Text.Caption}"
                               FontWeight="SemiBold"
                               TextWrapping="NoWrap"
                               VerticalAlignment="Center" />
                    <ProgressBar x:Name="LoadingBar"
                                 DockPanel.Dock="Right"
                                 Width="{StaticResource Layout.ProgressBarWidth}"
                                 Height="{StaticResource Layout.ProgressBarHeight}"
                                 Margin="8,0,0,0"
                                 IsIndeterminate="True"
                                 Visibility="Collapsed"
                                 VerticalAlignment="Center" />
                    <TextBlock x:Name="StatusInfoText"
                               Text="就绪"
                               Style="{StaticResource Text.Caption}"
                               Foreground="{StaticResource Brush.Text.Secondary}"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0" />
                </DockPanel>

                <TextBox x:Name="LogBox"
                         Grid.Row="1"
                         Style="{StaticResource TextBox.Code}"
                         Height="{StaticResource Layout.LogPanelHeight}"
                         IsReadOnly="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         TextWrapping="Wrap"
                         Padding="{StaticResource Layout.InputPadding.Multiline}" />
            </Grid>
        </Border>
    </Grid>
</Window>
