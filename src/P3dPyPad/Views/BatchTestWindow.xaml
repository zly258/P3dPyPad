<Window x:Class="P3dPyPad.BatchTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Plant 3D 批量测试器 (PYBATCH)"
        Width="1040"
        Height="620"
        MinWidth="820"
        MinHeight="440"
        WindowStartupLocation="CenterScreen">
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo x:Name="WindowTaskbarInfo" />
    </Window.TaskbarItemInfo>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/P3dPyPad;component/Theme/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{StaticResource Brush.WindowBackground}">
        <Grid.RowDefinitions>
            <!-- 0: 顶部配置与操作栏 -->
            <RowDefinition Height="Auto" />
            <!-- 1: 快捷筛选与单件联动条 -->
            <RowDefinition Height="Auto" />
            <!-- 2: 中间结果表格 -->
            <RowDefinition Height="*" />
            <!-- 3: 底部进度与状态栏 -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 0: 顶部配置区 -->
        <Border Grid.Row="0"
                Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="0,0,0,1"
                Padding="{StaticResource Layout.FormBarPadding}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="4" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="{StaticResource Layout.FormLabelMinWidth}" />
                    <ColumnDefinition Width="*" MinWidth="{StaticResource Layout.InputMinWidth}" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="{StaticResource Layout.ColumnGap}" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 脚本目录 -->
                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="{DynamicResource Loc.ScriptDirLabel}"
                           Style="{StaticResource Text.Caption}"
                           FontWeight="SemiBold"
                           TextWrapping="NoWrap"
                           VerticalAlignment="Center" />
                <TextBox Grid.Row="0" Grid.Column="1"
                         x:Name="SourceDirBox"
                         Style="{StaticResource TextBox.Form}"
                         ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                         Margin="0,0,6,0" />
                <Button Grid.Row="0" Grid.Column="2"
                        Content="{DynamicResource Loc.Browse}"
                        Style="{StaticResource Button.Secondary}"
                        Height="{StaticResource Layout.ControlHeight}"
                        Click="BrowseSource_Click"
                        ToolTip="选择包含 Plant 3D Python 脚本的源目录（支持递归扫描子目录）" />

                <!-- 出图目录 -->
                <TextBlock Grid.Row="2" Grid.Column="0"
                           Text="{DynamicResource Loc.OutputDirLabel}"
                           Style="{StaticResource Text.Caption}"
                           FontWeight="SemiBold"
                           TextWrapping="NoWrap"
                           VerticalAlignment="Center" />
                <TextBox Grid.Row="2" Grid.Column="1"
                         x:Name="OutputDirBox"
                         Style="{StaticResource TextBox.Form}"
                         ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                         Margin="0,0,6,0" />
                <Button Grid.Row="2" Grid.Column="2"
                        Content="{DynamicResource Loc.Browse}"
                        Style="{StaticResource Button.Secondary}"
                        Height="{StaticResource Layout.ControlHeight}"
                        Click="BrowseOutput_Click"
                                ToolTip="选择生成的截图保存目录" />

                <!-- 操作按钮组 -->
                <StackPanel Grid.Row="0" Grid.RowSpan="3" Grid.Column="4"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button x:Name="StartButton"
                            Content="{DynamicResource Loc.StartBatchBtn}"
                            Style="{StaticResource Button.Primary}"
                            Height="{StaticResource Layout.ControlHeight}"
                            FontWeight="SemiBold"
                            Click="StartBatch_Click"
                            ToolTip="在 AutoCAD 视口中批量运行各脚本，每个构件生成一张轴测图" />
                    <Button x:Name="StopButton"
                            Content="{DynamicResource Loc.StopBatchBtn}"
                            Style="{StaticResource Button.Secondary}"
                            Height="{StaticResource Layout.ControlHeight}"
                            Margin="6,0,0,0"
                            IsEnabled="False"
                            Click="StopBatch_Click"
                            ToolTip="中断正在进行的批量测试任务" />
                    <ComboBox x:Name="LanguageCombo"
                              Height="{StaticResource Layout.ControlHeight}"
                              FontSize="{StaticResource FontSize.Caption}"
                              Margin="6,0,0,0"
                              SelectionChanged="LanguageCombo_SelectionChanged"
                              ToolTip="切换界面语言 (Language: 中文 / English)">
                        <ComboBoxItem Content="Auto (系统)" Tag="Auto" />
                        <ComboBoxItem Content="中文 (Chinese)" Tag="Chinese" />
                        <ComboBoxItem Content="English" Tag="English" />
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 1: 状态过滤、截图模式与单件测试跳转条
             不提供任何"快捷目录"按钮：脚本目录由用户自己浏览选择，
             上次打开的目录会被记住，下次启动直接回到那里。 -->
        <Border Grid.Row="1"
                Background="{StaticResource Brush.SurfaceAlt}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="0,0,0,1"
                Padding="{StaticResource Layout.BarPadding}">
            <!-- 整条工具栏用一个 WrapPanel 承载：窗口足够宽时左右两组同排；
                 窗口变窄时右侧操作组整体换到下一行，绝不横向溢出被裁掉。
                 每个「标签 + 控件」再包成独立 StackPanel，换行只发生在组边界。 -->
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0">
                        <TextBlock Text="{DynamicResource Loc.FilterLabel}"
                                   Style="{StaticResource Text.Caption}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0" />
                        <ComboBox x:Name="FilterCombo"
                                  MinWidth="110"
                                  Height="{StaticResource Layout.ControlHeight}"
                                  SelectedIndex="0"
                                  SelectionChanged="FilterCombo_SelectionChanged">
                            <ComboBoxItem Content="{DynamicResource Loc.FilterAll}" />
                            <ComboBoxItem Content="{DynamicResource Loc.FilterSuccess}" />
                            <ComboBoxItem Content="{DynamicResource Loc.FilterFailed}" />
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Button Content="{DynamicResource Loc.OpenOutputDirBtn}"
                                Style="{StaticResource Button.Secondary}"
                                Height="{StaticResource Layout.ControlHeight}"
                                Click="OpenFolder_Click"
                                ToolTip="在资源管理器中打开截图与测试报告输出目录" />
                    </StackPanel>
            </WrapPanel>
        </Border>

        <!-- 2: 批量测试结果列表 (DataGrid) -->
        <Border Grid.Row="2" Margin="8,6,8,4"
                Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="1"
                CornerRadius="{StaticResource Radius.Small}">
            <Grid>
                <DataGrid x:Name="ResultGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{StaticResource Brush.Border}"
                          BorderThickness="0"
                          CanUserResizeColumns="True"
                          CanUserSortColumns="True"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          PreviewMouseRightButtonDown="ResultGrid_PreviewMouseRightButtonDown"
                          MouseDoubleClick="ResultGrid_MouseDoubleClick"
                          ToolTip="双击行可在系统默认查看器中打开截图，右键可复制路径或定位截图">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="打开截图" Click="MenuOpenImage_Click" />
                            <MenuItem Header="在资源管理器中定位截图" Click="MenuLocateImage_Click" />
                            <Separator />
                            <MenuItem Header="复制脚本路径" Click="MenuCopyScriptPath_Click" />
                            <MenuItem Header="复制截图路径" Click="MenuCopyImagePath_Click" />
                            <Separator />
                            <MenuItem Header="查看/复制失败详情" Click="MenuShowError_Click" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="42" MinWidth="42" CanUserSort="True"
                                            HeaderStyle="{StaticResource DataGridColumnHeader.RightAligned}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTemplateColumn Header="脚本文件" Width="150" MinWidth="110" SortMemberPath="ScriptName" CanUserSort="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ScriptName}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding ScriptPath}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="入口函数" Binding="{Binding EntryName}" Width="120" MinWidth="96" CanUserSort="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTemplateColumn Header="状态" Width="74" MinWidth="74" SortMemberPath="Success" CanUserSort="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Border x:Name="DoneBadge" Style="{StaticResource Badge.Done}">
                                            <TextBlock Text="成功" Style="{StaticResource BadgeText.Done}" FontWeight="SemiBold" />
                                        </Border>
                                        <Border x:Name="FailedBadge" Style="{StaticResource Badge.Failed}">
                                            <TextBlock Text="失败" Style="{StaticResource BadgeText.Failed}" FontWeight="SemiBold" />
                                        </Border>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Success}" Value="True">
                                            <Setter TargetName="DoneBadge" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="FailedBadge" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Success}" Value="False">
                                            <Setter TargetName="DoneBadge" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="FailedBadge" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="图元数" Binding="{Binding EntityCount}" Width="62" MinWidth="62" CanUserSort="True"
                                            HeaderStyle="{StaticResource DataGridColumnHeader.RightAligned}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="耗时(ms)" Binding="{Binding DurationMs}" Width="82" MinWidth="82" CanUserSort="True"
                                            HeaderStyle="{StaticResource DataGridColumnHeader.RightAligned}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTemplateColumn Header="截图" Width="176" MinWidth="150" SortMemberPath="ImageFileName" CanUserSort="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ImageFileName}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding ImagePath}"
                                                   x:Name="ImagePanel" />
                                        <TextBlock Text="—"
                                                   x:Name="NoImageText"
                                                   Foreground="{StaticResource Brush.Text.Disabled}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Visibility="Collapsed" />
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding HasImage}" Value="False">
                                            <Setter TargetName="ImagePanel" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="NoImageText" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="执行详情 / 异常信息" Width="*" MinWidth="150" SortMemberPath="ErrorMessage" CanUserSort="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ShortErrorMessage}"
                                                   x:Name="ErrorText"
                                                   Foreground="{StaticResource Brush.Danger}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding ErrorMessage}" />
                                        <TextBlock Text="截图已生成"
                                                   x:Name="SuccessText"
                                                   Foreground="{StaticResource Brush.Text.Secondary}"
                                                   VerticalAlignment="Center"
                                                   Visibility="Collapsed" />
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Success}" Value="True">
                                            <Setter TargetName="ErrorText" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="SuccessText" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel x:Name="EmptyState"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False"
                            Margin="0,0,0,20">
                    <StackPanel.Style>
                        <Style TargetType="{x:Type StackPanel}">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasItems, ElementName=ResultGrid}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="尚未开始批量测试或当前筛选无记录"
                               Style="{StaticResource Text.Caption}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="点击上方「浏览」选择脚本目录，然后点击「开始批量测试」。"
                               Style="{StaticResource Text.Caption}"
                               Foreground="{StaticResource Brush.Text.Disabled}"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3: 底部状态与进度条 -->
        <Border Grid.Row="3"
                Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="0,1,0,0"
                Padding="{StaticResource Layout.StatusBarPadding}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ProgressBar Grid.Column="0"
                                 x:Name="BatchProgress"
                                 Height="{StaticResource Layout.ProgressBarHeight}"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="0"
                                 VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               x:Name="ProgressText"
                               Text="0 / 0"
                               Style="{StaticResource Text.Caption}"
                               FontSize="{StaticResource FontSize.Micro}"
                               Foreground="{StaticResource Brush.Text.Secondary}"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0" />
                </Grid>

                <TextBlock Grid.Row="1"
                           x:Name="StatusText"
                           Text="就绪。请选择脚本目录并开始批量测试。"
                           Style="{StaticResource Text.Caption}"
                           Foreground="{StaticResource Brush.Text.Primary}"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
