<Window x:Class="P3dPyPad.BatchTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Plant 3D 批量测试器 (PYBATCH)"
        Width="1040"
        Height="620"
        MinWidth="820"
        MinHeight="440"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo x:Name="WindowTaskbarInfo" />
    </Window.TaskbarItemInfo>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/P3dPyPad;component/Theme/DefaultMetrics.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部目录与运行控制 -->
        <Border Grid.Row="0" Style="{StaticResource Panel.ToolStrip}" Margin="0,0,0,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="4" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="72" />
                    <ColumnDefinition Width="*" MinWidth="160" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Loc.ScriptDirLabel}" Margin="0,0,6,0" />
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="SourceDirBox" Margin="0,0,6,0" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                <Button Grid.Row="0" Grid.Column="2" Content="{DynamicResource Loc.Browse}" Click="BrowseSource_Click" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource Loc.OutputDirLabel}" Margin="0,0,6,0" />
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="OutputDirBox" Margin="0,0,6,0" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                <Button Grid.Row="2" Grid.Column="2" Content="{DynamicResource Loc.Browse}" Click="BrowseOutput_Click" />

                <StackPanel Grid.Row="0" Grid.RowSpan="3" Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="StartButton"
                            Content="{DynamicResource Loc.StartBatchBtn}"
                            FontWeight="SemiBold"
                            Click="StartBatch_Click" />
                    <Button x:Name="StopButton"
                            Content="{DynamicResource Loc.StopBatchBtn}"
                            Margin="6,0,0,0"
                            IsEnabled="False"
                            Click="StopBatch_Click" />
                    <ComboBox x:Name="LanguageCombo"
                              Margin="6,0,0,0"
                              SelectionChanged="LanguageCombo_SelectionChanged">
                        <ComboBoxItem Content="Auto (系统)" Tag="Auto" />
                        <ComboBoxItem Content="中文 (Chinese)" Tag="Chinese" />
                        <ComboBoxItem Content="English" Tag="English" />
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 筛选栏 -->
        <Border Grid.Row="1" Style="{StaticResource Panel.ToolStrip}" Margin="0,0,0,8">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="{DynamicResource Loc.FilterLabel}" Margin="0,0,6,0" />
                    <ComboBox x:Name="FilterCombo" MinWidth="110" SelectedIndex="0" SelectionChanged="FilterCombo_SelectionChanged">
                        <ComboBoxItem Content="{DynamicResource Loc.FilterAll}" />
                        <ComboBoxItem Content="{DynamicResource Loc.FilterSuccess}" />
                        <ComboBoxItem Content="{DynamicResource Loc.FilterFailed}" />
                    </ComboBox>
                </StackPanel>

                <Button Content="{DynamicResource Loc.OpenOutputDirBtn}" Click="OpenFolder_Click" />
            </WrapPanel>
        </Border>

        <!-- 结果表格 -->
        <Grid Grid.Row="2" Margin="0,0,0,8">
            <DataGrid x:Name="ResultGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      HeadersVisibility="Column"
                      CanUserResizeColumns="True"
                      CanUserSortColumns="True"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      PreviewMouseRightButtonDown="ResultGrid_PreviewMouseRightButtonDown"
                      MouseDoubleClick="ResultGrid_MouseDoubleClick">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="打开截图" Click="MenuOpenImage_Click" />
                        <MenuItem Header="在资源管理器中定位截图" Click="MenuLocateImage_Click" />
                        <Separator />
                        <MenuItem Header="复制脚本路径" Click="MenuCopyScriptPath_Click" />
                        <MenuItem Header="复制截图路径" Click="MenuCopyImagePath_Click" />
                        <Separator />
                        <MenuItem Header="查看/复制失败详情" Click="MenuShowError_Click" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="44" MinWidth="42" ElementStyle="{StaticResource DataGridText.Cell}" />
                    <DataGridTextColumn Header="脚本文件" Binding="{Binding ScriptName}" Width="150" MinWidth="110" ElementStyle="{StaticResource DataGridText.Cell}" />
                    <DataGridTextColumn Header="入口函数" Binding="{Binding EntryName}" Width="120" MinWidth="96" ElementStyle="{StaticResource DataGridText.Cell}" />
                    <DataGridTemplateColumn Header="状态" Width="70" MinWidth="68" SortMemberPath="Success">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock x:Name="DoneText" Text="成功" Foreground="DarkGreen" FontWeight="SemiBold" />
                                    <TextBlock x:Name="FailText" Text="失败" Foreground="Firebrick" FontWeight="SemiBold" Visibility="Collapsed" />
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Success}" Value="False">
                                        <Setter TargetName="DoneText" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="FailText" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="图元数" Binding="{Binding EntityCount}" Width="66" MinWidth="60" ElementStyle="{StaticResource DataGridText.Cell}" />
                    <DataGridTextColumn Header="耗时(ms)" Binding="{Binding DurationMs}" Width="82" MinWidth="72" ElementStyle="{StaticResource DataGridText.Cell}" />
                    <DataGridTextColumn Header="截图" Binding="{Binding ImageFileName}" Width="170" MinWidth="130" ElementStyle="{StaticResource DataGridText.Cell}" />
                    <DataGridTemplateColumn Header="执行详情 / 异常信息" Width="*" MinWidth="150" SortMemberPath="ErrorMessage">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid VerticalAlignment="Center" Margin="6,0">
                                    <TextBlock x:Name="ErrorText" Text="{Binding ShortErrorMessage}" Foreground="Firebrick" TextTrimming="CharacterEllipsis" ToolTip="{Binding ErrorMessage}" />
                                    <TextBlock x:Name="SuccessText" Text="截图已生成" Foreground="{x:Static SystemColors.GrayTextBrush}" Visibility="Collapsed" />
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Success}" Value="True">
                                        <Setter TargetName="ErrorText" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="SuccessText" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock x:Name="EmptyState"
                       Text="暂无记录，请选择脚本目录后开始批量测试。"
                       Foreground="{x:Static SystemColors.GrayTextBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False">
                <TextBlock.Style>
                    <Style TargetType="{x:Type TextBlock}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasItems, ElementName=ResultGrid}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <!-- 底部进度与状态 -->
        <Border Grid.Row="3" Style="{StaticResource Panel.InfoBar}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ProgressBar Grid.Column="0" x:Name="BatchProgress" Height="14" Minimum="0" Maximum="100" Value="0" />
                    <TextBlock Grid.Column="1" x:Name="ProgressText" Text="0 / 0" Foreground="{x:Static SystemColors.GrayTextBrush}" Margin="8,0,0,0" />
                </Grid>
                <TextBlock Grid.Row="1" x:Name="StatusText" Text="就绪" TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>
    </Grid>
</Window>
