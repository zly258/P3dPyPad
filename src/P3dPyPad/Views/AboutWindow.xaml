<Window x:Class="P3dPyPad.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Loc.AboutTitle}"
        Width="420"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/P3dPyPad;component/Theme/DefaultMetrics.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Panel.Card}" Margin="0,0,0,8">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="P3dPyPad" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="{DynamicResource Loc.AboutDesc}" Margin="0,4,0,2" />
                <TextBlock Text="{DynamicResource Loc.AboutVersion}" Foreground="{x:Static SystemColors.GrayTextBrush}" />
            </StackPanel>
        </Border>

        <GroupBox Grid.Row="1" Header="核心功能" Margin="0,0,0,8">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="• 脚本测试 (PYPAD)：参数化脚本热更新与 3D 实时建模" Margin="0,2" />
                <TextBlock Text="• 批量测试 (PYBATCH)：构件目录自动批量运行与出图检验" Margin="0,2" />
                <TextBlock Text="• 创建设备 (PYEQCREATE)：搜索选型、缩放预览与 3D 实时放置设备" Margin="0,2" />
                <TextBlock Text="• 双语切换 (PYLANG)：中英文界面即时切换" Margin="0,2" />
            </StackPanel>
        </GroupBox>

        <GroupBox Grid.Row="2" Header="{DynamicResource Loc.AboutLinksHeader}" Margin="0,0,0,10">
            <Grid Margin="2,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="{DynamicResource Loc.AboutRepoLabel}"
                           Foreground="{x:Static SystemColors.GrayTextBrush}"
                           Margin="0,3,6,3" />
                <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,3" TextWrapping="Wrap">
                    <Hyperlink NavigateUri="https://github.com/zly258/P3dPyPad"
                               RequestNavigate="Hyperlink_RequestNavigate">https://github.com/zly258/P3dPyPad</Hyperlink>
                </TextBlock>

                <TextBlock Grid.Row="1" Grid.Column="0"
                           Text="{DynamicResource Loc.AboutEmailLabel}"
                           Foreground="{x:Static SystemColors.GrayTextBrush}"
                           Margin="0,3,6,3" />
                <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,3" TextWrapping="Wrap">
                    <Hyperlink NavigateUri="mailto:zhangly1403@gmail.com"
                               RequestNavigate="Hyperlink_RequestNavigate">zhangly1403@gmail.com</Hyperlink>
                </TextBlock>

                <TextBlock Grid.Row="2" Grid.Column="0"
                           Text="{DynamicResource Loc.AboutSponsorLabel}"
                           Foreground="{x:Static SystemColors.GrayTextBrush}"
                           Margin="0,3,6,3" />
                <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,3" TextWrapping="Wrap">
                    <Hyperlink NavigateUri="https://ifdian.net/order/create?user_id=3db8e630e6dc11f1b37452540025c377"
                               ToolTip="https://ifdian.net/order/create?user_id=3db8e630e6dc11f1b37452540025c377"
                               RequestNavigate="Hyperlink_RequestNavigate">
                        <Run Text="{DynamicResource Loc.AboutSponsorText}" />
                    </Hyperlink>
                </TextBlock>
            </Grid>
        </GroupBox>

        <DockPanel Grid.Row="3" LastChildFill="False">
            <TextBlock Text="AutoCAD Plant 3D 2019–2026"
                       Foreground="{x:Static SystemColors.GrayTextBrush}"
                       DockPanel.Dock="Left" />
            <Button Content="{DynamicResource Loc.Close}"
                    IsCancel="True"
                    Click="OkButton_Click"
                    DockPanel.Dock="Right" />
        </DockPanel>
    </Grid>
</Window>
