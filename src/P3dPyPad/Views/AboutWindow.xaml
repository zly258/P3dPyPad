<Window x:Class="P3dPyPad.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Loc.AboutTitle}"
        Width="420"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/P3dPyPad;component/Theme/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{StaticResource Brush.WindowBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header Card -->
        <Border Grid.Row="0"
                Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="0,0,0,1"
                Padding="{StaticResource Layout.HeaderPadding}">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="P3dPyPad"
                           FontSize="{StaticResource FontSize.Display}"
                           FontWeight="Bold"
                           Foreground="{StaticResource Brush.Accent}" />
                <TextBlock Text="{DynamicResource Loc.AboutDesc}"
                           Style="{StaticResource Text.Body}"
                           Margin="0,4,0,2" />
                <TextBlock Text="{DynamicResource Loc.AboutVersion}"
                           Style="{StaticResource Text.Caption}"
                           Foreground="{StaticResource Brush.Text.Secondary}" />
            </StackPanel>
        </Border>

        <!-- Feature List -->
        <Border Grid.Row="1"
                Background="{StaticResource Brush.SurfaceAlt}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="0,0,0,1"
                Padding="{StaticResource Layout.StatusBarPadding}">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="核心功能："
                           FontWeight="SemiBold"
                           Style="{StaticResource Text.Caption}"
                           Margin="0,0,0,6" />
                <TextBlock Text="• 脚本测试 (PYPAD)：单件参数化脚本热更新与 3D 实时建模"
                           Style="{StaticResource Text.Caption}"
                           Margin="0,2" />
                <TextBlock Text="• 批量测试 (PYBATCH)：构件目录全自动批量运行、截图检验与测试报告"
                           Style="{StaticResource Text.Caption}"
                           Margin="0,2" />
                <TextBlock Text="• 双语切换 (PYLANG)：中英文界面即时切换，无缝适配多语言"
                           Style="{StaticResource Text.Caption}"
                           Margin="0,2" />
            </StackPanel>
        </Border>

        <!-- Bottom Action Bar -->
        <Border Grid.Row="2"
                Background="{StaticResource Brush.Surface}"
                Padding="{StaticResource Layout.StatusBarPadding}">
            <DockPanel LastChildFill="False">
                <TextBlock Text="Plant 3D Parametric Components Toolset"
                           Style="{StaticResource Text.Caption}"
                           Foreground="{StaticResource Brush.Text.Secondary}"
                           VerticalAlignment="Center"
                           DockPanel.Dock="Left" />
                <Button Content="{DynamicResource Loc.Close}"
                        Style="{StaticResource Button.Primary}"
                        Height="{StaticResource Layout.ControlHeight}"
                        Click="OkButton_Click"
                        DockPanel.Dock="Right" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
